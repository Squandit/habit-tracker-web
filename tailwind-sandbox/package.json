{
  "name": "habit-tracker-tailwind-sandbox",
  "private": true,
  "version": "1.0.0",
  "description": "Playground for learning Tailwind CSS. Does not touch the main app.",
  "scripts": {
    "dev": "tailwindcss -i ./src/input.css -o ./dist/output.css --watch",
    "build": "tailwindcss -i ./src/input.css -o ./dist/output.css --minify"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
